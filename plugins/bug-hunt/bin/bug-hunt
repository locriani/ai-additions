#!/usr/bin/env python3
"""bug-hunt — run the bug-hunt skill headless, and turn its findings.json into a report and an exit code.

  bug-hunt run [--repo .] [--out DIR] [--path P ...] [--since REF] [--budget 10]
  bug-hunt report FINDINGS.json

`run` makes a detached worktree at HEAD outside the checkout, runs `claude -p "/bug-hunt:bug-hunt ..."` with
no permission prompts and a spend cap, removes the worktree whatever happens, then reports. The skill writes
only inside the worktree and the out dir; a checkout that changed anyway is recorded as an incomplete reason.

`report` validates findings.json and writes findings.md next to it; the JSON is the single source. `run` also keeps
claude's own JSON result (cost, turns, session id) as session.json.

Exit codes: 0 the hunt completed and proved no bug, 1 at least one proven bug, 2 no proven bug and the hunt
was incomplete, or the report is invalid, or there was nothing to hunt. A hunt that did not finish never passes.
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

SEVERITIES = ("critical", "high", "medium", "low")
TOP = ("version", "repo", "commit", "status", "scope", "candidates", "refuted", "findings")
FIELDS = ("id", "title", "severity", "path", "line", "expected", "actual", "intent_evidence")
REPRO = ("command", "content", "failure_excerpt")
BG_WAIT_MS = str(60 * 60 * 1000)  # -p waits this long for subagents still running; the default is 10 min
IN_PROGRESS = "in progress"  # the reason the skill writes with each partial save; run drops it once it knows why


def problems(doc) -> list[str]:
    if not isinstance(doc, dict):
        return ["the report is not a JSON object"]
    out = [f"missing {k}" for k in TOP if k not in doc]
    if doc.get("status") not in ("complete", "incomplete"):
        out.append("status must be complete or incomplete")
    if doc.get("status") == "incomplete" and not doc.get("incomplete_reasons"):
        out.append("an incomplete report needs incomplete_reasons")
    for k in ("candidates", "refuted"):
        if k in doc and not isinstance(doc[k], int):
            out.append(f"{k} must be an integer")
    findings = doc.get("findings", [])
    if not isinstance(findings, list):
        return out + ["findings must be a list"]
    for n, f in enumerate(findings):
        where = f"findings[{n}]"
        if not isinstance(f, dict):
            out.append(f"{where} is not an object")
            continue
        out += [f"{where}.{k} is missing or empty" for k in FIELDS if f.get(k) in (None, "")]
        if f.get("severity") and f["severity"] not in SEVERITIES:
            out.append(f"{where}.severity must be one of {', '.join(SEVERITIES)}")
        if "line" in f and not (isinstance(f["line"], int) and f["line"] >= 1):
            out.append(f"{where}.line must be a positive integer")
        repro = f.get("repro") if isinstance(f.get("repro"), dict) else {}
        out += [f"{where}.repro.{k} is missing or empty" for k in REPRO if not repro.get(k)]
    return out


def fence(text: str, lang: str = "") -> str:
    ticks = "```"
    while ticks in text:
        ticks += "`"
    return f"{ticks}{lang}\n{text.rstrip()}\n{ticks}"


def markdown(doc) -> str:
    found = sorted(doc["findings"], key=lambda f: SEVERITIES.index(f["severity"]))
    scope = doc["scope"]
    lines = [f"# Bug hunt: {doc['repo']} @ {doc['commit'][:12]}", "",
             f"**{len(found)} proven** · {doc['candidates']} candidate{'s' * (doc['candidates'] != 1)}"
             f" · {doc['refuted']} refuted · {doc['status']}"]
    if doc["status"] == "incomplete":
        lines += ["", "Incomplete, so a clean result here is not a pass:", *[f"- {r}" for r in doc["incomplete_reasons"]]]
    base = doc.get("baseline") or {}
    lines += ["", f"- Test command: `{doc.get('test_command') or 'none found'}`"
                  + (f", baseline exit {base['exit']}" if "exit" in base else "")]
    for label, key in (("Paths", "paths"), ("Hunted", "files_hunted"), ("Skipped", "files_skipped")):
        if scope.get(key):
            lines.append(f"- {label}: {', '.join(f'`{p}`' for p in scope[key])}")
    if scope.get("since"):
        lines.append(f"- Since: `{scope['since']}`")
    if not found:
        lines += ["", "No bugs proven."]
    for f in found:
        r = f["repro"]
        lines += ["", f"## {f['id']} [{f['severity']}] {f['title']}", "",
                  f"`{f['path']}:{f['line']}`" + (f" · {f['class']}" if f.get("class") else ""), "",
                  f"- **Expected:** {f['expected']}", f"- **Actual:** {f['actual']}",
                  f"- **Why that is intended:** {f['intent_evidence']}"]
        if f.get("root_cause"):
            lines.append(f"- **Root cause:** {f['root_cause']}")
        where = f" (`{r['path']}`)" if r.get("path") else ""
        lines += ["", f"Repro{where}:", "",
                  fence(r["command"], "sh"), "", fence(r["content"]), "", "Fails with:", "", fence(r["failure_excerpt"])]
    return "\n".join(lines) + "\n"


def report(path: Path) -> int:
    try:
        doc = json.loads(path.read_text())
    except (OSError, ValueError) as e:
        print(f"bug-hunt: cannot read {path}: {e}", file=sys.stderr)
        return 2
    if bad := problems(doc):
        print(f"bug-hunt: {path} is invalid:\n" + "\n".join(f"  {p}" for p in bad), file=sys.stderr)
        return 2
    md = path.with_name("findings.md")
    md.write_text(markdown(doc))
    n = len(doc["findings"])
    print(f"bug-hunt: {n} proven bug{'s' * (n != 1)} ({doc['status']}) {md}")
    return 1 if n else 0 if doc["status"] == "complete" else 2


def git(repo: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True)


def status(repo: Path, out: Path) -> str:
    """The checkout's status, leaving out the report dir when it sits inside the checkout."""
    spec = ["--", ".", f":(exclude){out.relative_to(repo)}"] if out.is_relative_to(repo) else []
    return git(repo, "status", "--porcelain", *spec).stdout


def rule_path(p: Path) -> str:
    return "/" + str(p)  # permission rules mark an absolute path with a leading `//`


def run(args) -> int:
    repo = Path(args.repo).resolve()
    head = git(repo, "rev-parse", "--verify", "HEAD")
    top = git(repo, "rev-parse", "--show-toplevel")
    if head.returncode or top.returncode:
        print(f"bug-hunt: {repo} is not a git work tree with a commit", file=sys.stderr)
        return 2
    repo, commit = Path(top.stdout.strip()), head.stdout.strip()
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    out = Path(args.out).resolve() if args.out else Path(tempfile.gettempdir(), "bug-hunt", f"{repo.name}-{stamp}").resolve()
    out.mkdir(parents=True, exist_ok=True)
    scratch = Path(tempfile.mkdtemp(prefix="bug-hunt-")).resolve()
    wt = scratch / "wt"
    before = status(repo, out)
    reasons, code = [], None
    try:
        added = git(repo, "worktree", "add", "--detach", str(wt), commit)
        if added.returncode:
            reasons.append(f"could not create the worktree: {added.stderr.strip()}")
        else:
            prompt = shlex.join(["/bug-hunt:bug-hunt", "--worktree", str(wt), "--out", str(out),
                                 *[a for p in args.path for a in ("--path", p)],
                                 *(["--since", args.since] if args.since else [])])
            allowed = ["Read", "Grep", "Glob", "Agent", "Bash", f"Edit({rule_path(wt)}/**)", f"Edit({rule_path(out)}/**)"]
            argv = ["claude", "-p", prompt, "--permission-mode", "dontAsk", "--permission-prompts", "none",
                    "--max-budget-usd", str(args.budget), "--output-format", "json",
                    "--allowedTools", ",".join(allowed), "--disallowedTools", "Bash(git push *)"]
            env = {**os.environ, "CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS": BG_WAIT_MS}
            try:
                with open(out / "session.json", "w") as session:  # claude's own result: cost, turns, session id
                    code = subprocess.run(argv, cwd=wt, env=env, stdout=session).returncode
            except FileNotFoundError:
                reasons.append("claude is not on PATH")
    finally:
        git(repo, "worktree", "remove", "--force", str(wt))
        git(repo, "worktree", "prune")
        shutil.rmtree(scratch, ignore_errors=True)
    if code:
        reasons.append(f"claude exited {code}" + (" (the spend cap or an auth failure)" if code == 2 else ""))
    if status(repo, out) != before:
        reasons.append("the checkout changed during the hunt; the hunt must write only in its worktree and out dir")
    return report(finish(out / "findings.json", repo, commit, args, reasons))


def finish(path: Path, repo: Path, commit: str, args, reasons: list[str]) -> Path:
    """Fold the run's own reasons into the skill's report, or write a stub report when the skill left none."""
    try:
        doc = json.loads(path.read_text())
    except (OSError, ValueError):
        missing = not path.exists()
        if not missing:
            path.rename(path.with_name("findings.unreadable.json"))  # keep what the skill wrote for a post-mortem
        doc = {"version": 1, "repo": repo.name, "commit": commit, "status": "incomplete", "incomplete_reasons": [],
               "scope": {"paths": args.path, "since": args.since}, "candidates": 0, "refuted": 0, "findings": []}
        reasons = ["the skill wrote no findings.json" if missing else
                   "the skill's findings.json was unreadable (kept as findings.unreadable.json)", *reasons]
    if reasons and isinstance(doc, dict):
        doc["status"] = "incomplete"
        doc["incomplete_reasons"] = [r for r in doc.get("incomplete_reasons") or [] if r != IN_PROGRESS] + reasons
        path.write_text(json.dumps(doc, indent=2) + "\n")
    return path


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="bug-hunt", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run", help="hunt headless with claude -p")
    r.add_argument("--repo", default=".")
    r.add_argument("--out", help="report dir (default: $TMPDIR/bug-hunt/<repo>-<utc stamp>)")
    r.add_argument("--path", action="append", default=[], help="limit the hunt to this path; repeatable")
    r.add_argument("--since", help="limit the hunt to files changed since this ref")
    r.add_argument("--budget", type=float, default=10.0, help="spend cap in USD (default 10)")
    p = sub.add_parser("report", help="validate findings.json, write findings.md, exit 0/1/2")
    p.add_argument("findings", type=Path)
    args = ap.parse_args(argv)
    return run(args) if args.cmd == "run" else report(args.findings)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
