#!/usr/bin/env bash
#
# gh-issue-rel.sh — manage native GitHub issue relationships (sub-issues +
# blocked-by dependencies) using first-party `gh api` REST calls only.
#
# GitHub exposes sub-issues and issue dependencies natively over REST, but `gh`'s
# high-level subcommands don't cover them. GITHUB.md forbids `gh api` and the
# github-api-stop-hook enforces that ban — so this wrapper IS the sanctioned
# high-level surface for those two relationship types. Call `gh-issue-rel`; never
# hand-roll the `gh api` calls it encapsulates.
#
# TOUCHES: nothing on the local filesystem. Issues sub-issue / blocked-by REST
# calls against GitHub for the resolved repo.
# DOES NOT TOUCH: labels, milestones, PRs, issue bodies, or any local file.
#
# Repo resolution (in precedence order):
#   1. `-R owner/name` / `--repo owner/name` (mirrors gh's own -R convention).
#   2. The git repo of the CALLER'S current working directory.
#   3. Neither → exit 2 naming -R as the fix. Never guesses.
# (This is installed globally to ~/.local/bin, which is not a git repo — so
# resolving from the script's own directory, as a repo-local copy would, is
# exactly wrong here.)
#
# Usage:
#   gh-issue-rel [-R owner/name] sub-add    <parent> <child>     # child becomes a native sub-issue of parent
#   gh-issue-rel [-R owner/name] sub-list   <issue>              # list native sub-issue numbers
#   gh-issue-rel [-R owner/name] block-add  <blocked> <blocker>  # mark <blocked> blocked-by <blocker>
#   gh-issue-rel [-R owner/name] block-list <issue>              # list blocker (blocked-by) issue numbers
#   gh-issue-rel [-R owner/name] show       <issue>              # sub-issues + blockers for <issue>
#
# Output contract: `sub-list` / `block-list` are machine-readable — one issue
# number per line, nothing else. `sub-add` / `block-add` / `show` are
# human-oriented. `block-list` lists what <issue> is blocked BY (its prereqs),
# not what it blocks.
#
# Requirements: gh CLI authenticated. macOS bash 3.2 compatible.

set -euo pipefail

command -v gh >/dev/null || { echo "gh not on PATH" >&2; exit 2; }

usage() {
  echo "usage: gh-issue-rel [-R owner/name] {sub-add|sub-list|block-add|block-list|show} <args>" >&2
  exit 2
}

# --- repo resolution ---------------------------------------------------------

REPO=""
while [ $# -gt 0 ]; do
  case "$1" in
    -R|--repo)
      [ $# -ge 2 ] || { echo "-R requires an owner/name argument" >&2; exit 2; }
      REPO="$2"; shift 2 ;;
    -R=*|--repo=*)
      REPO="${1#*=}"; shift ;;
    -h|--help) usage ;;
    *) break ;;
  esac
done

if [ -n "$REPO" ]; then
  case "$REPO" in
    */*) : ;;
    *) echo "not an owner/name repo: '$REPO'" >&2; exit 2 ;;
  esac
else
  origin=$(git -C "$PWD" remote get-url origin 2>/dev/null) || origin=""
  REPO=$(printf '%s' "$origin" \
    | sed -E 's#^(git@github\.com:|ssh://git@github\.com/|https://github\.com/)##; s#\.git$##')
  # The sed strips GitHub prefixes only, so a non-GitHub origin survives it
  # intact — `git@gitlab.com:o/n` keeps its colon, `https://gitlab.com/o/n`
  # keeps its slashes. Reject anything that isn't a bare owner/name rather than
  # splicing a URL into the REST path and failing with a confusing gh error.
  case "$REPO" in
    '')        echo "could not resolve a GitHub repo from $PWD — cd into the repo, or pass -R owner/name" >&2; exit 2 ;;
    */*/*|*:*) echo "origin is not a GitHub repo ($origin) — pass -R owner/name" >&2; exit 2 ;;
    */*)       : ;;
    *)         echo "origin is not a GitHub repo ($origin) — pass -R owner/name" >&2; exit 2 ;;
  esac
fi

# --- argument validation -----------------------------------------------------

# Every issue argument must be a bare issue number. Anything else (empty, `?`,
# `#`, path segments, flag-shaped) would be spliced into the REST path and can
# silently retarget the API call — e.g. `440?x` POSTs to the update-issue
# endpoint instead of the sub-issues endpoint and "succeeds".
validate_num() {
  case "$1" in
    ''|*[!0-9]*) echo "not an issue number: '$1'" >&2; exit 2 ;;
  esac
}

# The dependency/sub-issue *add* endpoints take the related issue's database id,
# not its number — resolve it.
issue_id() { gh api "repos/$REPO/issues/$1" --jq '.id'; }

cmd=${1:-}
if [ $# -gt 0 ]; then shift; fi
for arg in "$@"; do validate_num "$arg"; done

case "$cmd" in
  sub-add)
    [ $# -eq 2 ] || { echo "usage: sub-add <parent> <child>" >&2; exit 2; }
    child_id=$(issue_id "$2")
    gh api --method POST "repos/$REPO/issues/$1/sub_issues" \
      -F sub_issue_id="$child_id" >/dev/null
    echo "added #$2 as a sub-issue of #$1"
    ;;
  sub-list)
    [ $# -eq 1 ] || { echo "usage: sub-list <issue>" >&2; exit 2; }
    gh api --paginate "repos/$REPO/issues/$1/sub_issues" --jq '.[].number'
    ;;
  block-add)
    [ $# -eq 2 ] || { echo "usage: block-add <blocked> <blocker>" >&2; exit 2; }
    blocker_id=$(issue_id "$2")
    gh api --method POST "repos/$REPO/issues/$1/dependencies/blocked_by" \
      -F issue_id="$blocker_id" >/dev/null
    echo "#$1 is now blocked by #$2"
    ;;
  block-list)
    [ $# -eq 1 ] || { echo "usage: block-list <issue>" >&2; exit 2; }
    gh api --paginate "repos/$REPO/issues/$1/dependencies/blocked_by" --jq '.[].number'
    ;;
  show)
    [ $# -eq 1 ] || { echo "usage: show <issue>" >&2; exit 2; }
    echo "sub-issues:"
    gh api --paginate "repos/$REPO/issues/$1/sub_issues" \
      --jq '.[] | "  #\(.number) \(.title)"' || echo "  (query failed)"
    echo "blocked by:"
    gh api --paginate "repos/$REPO/issues/$1/dependencies/blocked_by" \
      --jq '.[] | "  #\(.number) \(.title)"' || echo "  (query failed)"
    ;;
  *)
    usage
    ;;
esac
